# Commodity Intelligence Terminal — local configuration
#
# Copy to `.env.local` and fill in only what you need. The terminal runs fully
# offline with every value below left blank. Never commit real credentials.

# ---------------------------------------------------------------------------
# AI analysis provider
# ---------------------------------------------------------------------------
# `local`  — deterministic offline template (default, no network access)
# `cloud`  — OpenAI-compatible chat completions endpoint
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Defaults to ./data/commodity-terminal.db when unset.
CIT_DATABASE_PATH=

# ---------------------------------------------------------------------------
# Public demo (Vercel / read-only hosting)
# ---------------------------------------------------------------------------
# Set to 1 on the public deployment only. Serves sanitized JSON from
# public-data/snapshot.json, disables the scheduler, and refuses all writes.
# Leave unset for local full-featured development.
CIT_PUBLIC_DEMO=
# Optional override for the snapshot file path (defaults to public-data/snapshot.json).
CIT_PUBLIC_SNAPSHOT_PATH=

# ---------------------------------------------------------------------------
# Ingestion etiquette
# ---------------------------------------------------------------------------
# Identifies the terminal to public web servers. Use a contact address you own.
CIT_USER_AGENT=CommodityIntelligenceTerminal/1.0 (local personal research)
